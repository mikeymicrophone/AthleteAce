<dialog id="shell-search" class="shell-search-dialog" data-search-target="dialog" data-action="close->search#closed click->search#backdrop" aria-labelledby="shell-search-title">
  <div class="search-heading"><h2 id="shell-search-title">Search</h2><button type="button" class="tool-button" aria-label="Close search" data-action="search#close"><%= icon "x", size: 18 %></button></div>
  <%= form_with url: search_path, method: :get, class: "search-form", data: { search_target: "form", action: "submit->search#submit" } do |form| %>
    <%= form.hidden_field :side, value: current_side %>
    <%= form.label :q, shell_search_placeholder, for: "shell-search-query", class: "sr-only" %>
    <%= form.search_field :q, id: "shell-search-query", placeholder: shell_search_placeholder, autocomplete: "off", maxlength: 80,
      role: "combobox", aria: { controls: "shell-search-results", autocomplete: "list", expanded: true },
      data: { search_target: "input", action: "input->search#search keydown->search#navigate" } %>
  <% end %>
  <p class="search-status" role="status" data-search-target="status">Enter at least 2 characters.</p>
  <section class="search-recents" data-search-target="recents" hidden><h3>Recent searches</h3><div data-search-target="recentList"></div><button type="button" class="tool-link" data-action="search#clearRecents">Clear recent searches</button></section>
  <div id="shell-search-results" class="search-results" role="listbox" aria-label="Search results" data-search-target="results"></div>
  <p class="search-keyboard-hint"><kbd>↑</kbd> <kbd>↓</kbd> to choose · <kbd>Enter</kbd> to open · <kbd>Esc</kbd> to close</p>
</dialog>
