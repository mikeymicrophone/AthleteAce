<%= tag.nav class: "navigation-container", aria: { label: "Main navigation" } do %>
  <%= tag.div class: "navigation-inner" do %>
    <%= link_to root_path, class: "ace-brand" do %>
      <%= tag.span icon("bolt", size: 24), class: "ace-brand-mark" %>
      <%= tag.span "Athlete Ace" %>
    <% end %>

    <%= tag.div class: "nav-menu" do %>
      <%= link_to strength_path, class: "nav-play #{controller_name == 'strength' ? 'active' : ''}" do %>
        <%= icon "player-play", size: 18 %>
        <%= tag.span "Play" %>
      <% end %>
      <% {
        "Teams" => %w[sports leagues conferences divisions teams players stadiums memberships contracts activations],
        "Locations" => %w[countries states cities],
        "Quests" => %w[quests goals achievements strength game_history ratings spectrums],
        "Time" => %w[years seasons contests]
      }.each do |label, resources| %>
        <%= tag.div class: "nav-group", data: { controller: "dropdown" } do %>
          <%= tag.button type: "button", class: "nav-group-title", aria: { expanded: false, controls: "nav-#{label.downcase}" },
            data: { dropdown_target: "toggle", action: "click->dropdown#toggle keydown.esc->dropdown#escape" } do %>
            <%= tag.span label %>
            <%= icon "chevron-down", size: 16 %>
          <% end %>
          <%= tag.div id: "nav-#{label.downcase}", class: "nav-dropdown", data: { dropdown_target: "menu", action: "keydown.esc->dropdown#escape" } do %>
            <%= tag.p label, class: "nav-dropdown-heading" %>
            <% resources.each do |resource| %>
              <% path = resource == "game_history" ? strength_game_attempts_path : public_send("#{resource}_path") %>
              <%= link_to path, class: "nav-dropdown-item #{current_page?(path) ? 'active' : ''}" do %>
                <%= resource == "game_history" ? icon("history", size: 20) : icon_for_resource(resource, size: 20) %>
                <%= tag.span resource.titleize %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% if ace_signed_in? %>
        <%= link_to random_quests_path, class: "nav-quest", aria: { label: "Begin Quest" }, title: "Begin Quest" do %>
          <%= icon "flag", size: 16 %>
          <%= tag.span "Begin Quest" %>
        <% end %>
      <% end %>
    <% end %>

    <%= tag.div class: "nav-account" do %>
      <%= ace_auth_links %>
    <% end %>
  <% end %>
<% end %>
