<header class="navigation-container" data-controller="shell" data-action="turbo:before-cache@document->shell#close">
  <div class="navigation-inner">
    <%= link_to root_path, class: "ace-brand", aria: { label: "Athlete Ace home" } do %>
      <span class="ace-brand-mark"><%= icon "bolt", size: 24 %></span><span>Athlete Ace</span>
    <% end %>
    <nav class="shell-sides" aria-label="Switch sides">
      <% shell_sides.each do |side, label, glyph, path| %>
        <%= link_to path, class: "shell-side #{'active' if current_side == side}", data: { side: side }, aria: { current: current_side == side ? "page" : nil, label: label } do %>
          <%= icon glyph, size: 20 %><span class="shell-side-label"><%= label %></span>
          <% if side == "play" && !ace_signed_in? %><span class="shell-preview">Preview</span><% end %>
          <% if side == "mod" && shell_pending_count.positive? %><span class="shell-badge" aria-label="<%= pluralize(shell_pending_count, 'submission') %> waiting"><%= shell_pending_count %></span><% end %>
        <% end %>
      <% end %>
    </nav>
    <div class="nav-account">
      <% unless ace_signed_in? %><%= link_to "Sign In", new_ace_session_path, class: "auth-link" %><% end %>
      <button type="button" class="shell-account-toggle" aria-label="<%= ace_signed_in? ? 'Account menu' : 'Appearance' %>" aria-expanded="false" aria-controls="shell-account" data-shell-target="toggle" data-action="shell#open">
        <%= icon ace_signed_in? ? "users" : "sun", size: 22 %>
      </button>
    </div>
  </div>
  <% if %w[play feed].include?(current_side) %>
    <div class="shell-tab-row">
      <%= render "layouts/side_links", location: "desktop" %>
      <% if current_side == "play" && current_ace %>
        <div class="shell-play-actions"><span class="shell-streak"><%= icon "bolt", size: 16 %><%= shell_streak %> day streak</span>
          <%= button_to "Quick round", game_rounds_path, params: { game_type: "player_team_match", length: 10 }, class: "shell-quick-round" %>
        </div>
      <% elsif current_side == "feed" && !current_ace %><p class="shell-reading-note">Reading is open to everyone</p><% end %>
    </div>
  <% end %>
  <%= render "layouts/account_menu" %>
</header>
