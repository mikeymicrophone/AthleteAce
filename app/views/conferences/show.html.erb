<% content_for :title, @conference.name %>
<%= browse_header @conference.name do %>
  <%= link_to "Practice", new_game_round_path(conference_id: @conference.id), class: "game-button" %>
  <%= link_to "Back to Conferences", conferences_path, class: "tool-button" %>
<% end %>
<%= browse_metadata "League" => entity_link(@conference.league), "Abbreviation" => @conference.abbreviation %>
<%= render_collection @divisions, parent: @conference, link_to_collection: true %>
<%= render_collection @teams, parent: @conference, link_to_collection: true %>
