<% content_for :title, "Spectrums" %>

<div class="w-full">
  <%= browse_header "Rating Spectrums" do %>
    <% if ace_signed_in? %>
      <%= link_to "New Spectrum", new_spectrum_path, class: "tool-button" %>
    <% end %>
  <% end %>
  <%= browse_empty @spectrums, "Spectrums" %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @spectrums.each do |spectrum| %>
      <div class="catalog-record">
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2"><%= link_to spectrum.name, spectrum, class: "hover:text-accent-text" %></h2>
          <p class="text-ink-2 mb-4"><%= spectrum.description %></p>

          <div class="flex justify-between text-sm mb-4">
            <span class="text-red-500"><%= spectrum.low_label %></span>
            <span class="text-green-500"><%= spectrum.high_label %></span>
          </div>

          <div class="flex justify-between items-center mt-4">
            <%= link_to "You have " + pluralize(current_ace.ratings.by_spectrum(spectrum).count, "rating"), spectrum, class: "text-accent-text hover:text-ink" if ace_signed_in? %>
            <%= link_to "Total is " + pluralize(spectrum.ratings.count, "rating"), [spectrum, :ratings], class: "text-accent-text hover:text-ink" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
