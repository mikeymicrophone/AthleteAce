<%= moderation_notice(@spectrum) %>
<%= render "aces/attribution", ace: @spectrum.created_by %>
<% content_for :title, @spectrum.name %>

<div class="w-full">
  <%= browse_header @spectrum.name do %>
    <% if admin_signed_in? %>
      <%= link_to "Edit", edit_spectrum_path(@spectrum), class: "tool-button" %>
      <%= button_to "Delete", @spectrum, method: :delete, class: "tool-button", data: { turbo_confirm: "Are you sure? This will delete all ratings on this spectrum." } %>
    <% end %>
  <% end %>
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="bg-surface rounded-card overflow-hidden mb-6">
    <div class="p-6">
      <div class="mb-6">
        <h2 class="text-lg font-semibold mb-2">Description</h2>
        <p class="text-ink-2"><%= @spectrum.description %></p>
      </div>

      <div class="mb-6">
        <h2 class="text-lg font-semibold mb-2">Scale</h2>
        <div class="flex items-center">
          <div class="w-full bg-line rounded-full h-4">
            <div class="flex justify-between px-2 text-xs">
              <span class="text-ink-2">-10,000</span>
              <span class="text-ink-2">0</span>
              <span class="text-ink-2">+10,000</span>
            </div>
          </div>
        </div>
        <div class="flex justify-between mt-1">
          <span class="text-red-500 font-medium"><%= @spectrum.low_label %></span>
          <span class="text-green-500 font-medium"><%= @spectrum.high_label %></span>
        </div>
      </div>
    </div>
  </div>

  <% if ace_signed_in? && @spectrum.ratings.where(ace: current_ace).exists? %>
    <div class="mb-6">
      <h2 class="font-bold text-2xl mb-4">Your Ratings on this Spectrum</h2>

      <div class="bg-surface rounded-card overflow-hidden">
        <ul class="divide-y divide-line">
          <% @spectrum.ratings.where(ace: current_ace).includes(:target).order(created_at: :desc).each do |rating| %>
            <li class="p-4 hover:bg-surface-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between">
                <div>
                  <div class="font-medium">
                    <% if rating.target_type == 'Player' %>
                      <%= link_to rating.target.name, player_path(rating.target), class: "text-accent-text hover:underline" %>
                      <span class="text-ink-3 text-sm">(Player)</span>
                    <% elsif rating.target_type == 'Team' %>
                      <%= link_to rating.target.name, team_path(rating.target), class: "text-accent-text hover:underline" %>
                      <span class="text-ink-3 text-sm">(Team)</span>
                    <% end %>
                  </div>

                  <div class="mt-2">
                    <div class="w-full bg-line rounded-full h-2.5">
                      <div class="<%= rating.value >= 0 ? 'bg-green-600' : 'bg-red-600' %> h-2.5 rounded-full" style="width: <%= rating.percentage_value %>%"></div>
                    </div>
                    <div class="flex justify-between text-xs mt-1">
                      <span><%= rating.value %></span>
                      <span><%= rating.percentage_value %>%</span>
                    </div>
                  </div>

                  <% if rating.notes.present? %>
                    <div class="mt-2 text-sm text-ink-2">
                      <%= rating.notes %>
                    </div>
                  <% end %>
                </div>

                <div class="mt-3 sm:mt-0 flex space-x-2">
                  <%= link_to "Edit", edit_rating_path(rating), class: "text-accent-text hover:text-ink" %>
                  <%= button_to "Delete", rating, method: :delete, class: "text-red-600 hover:text-red-800", data: { turbo_confirm: "Are you sure?" } %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="mb-6">
    <%= link_to "Back to Spectrums", spectrums_path, class: "rounded-md px-3.5 py-2.5 bg-surface-2 hover:bg-line inline-block font-medium" %>
  </div>
</div>
