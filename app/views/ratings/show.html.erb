<% content_for :title, "Rating Details" %>

<div class="mx-auto md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= browse_header "Rating Details" %>

  <div class="bg-surface rounded-card overflow-hidden mb-6">
    <div class="p-6">
      <div class="mb-4">
        <h2 class="text-xl font-semibold mb-2">Target</h2>
        <p class="text-ink-2">
          <% if @rating.target_type == 'Player' %>
            <%= link_to @rating.target.name, player_path(@rating.target), class: "text-accent-text hover:underline" %>
            <span class="text-ink-3 text-sm">(Player)</span>
          <% elsif @rating.target_type == 'Team' %>
            <%= link_to @rating.target.name, team_path(@rating.target), class: "text-accent-text hover:underline" %>
            <span class="text-ink-3 text-sm">(Team)</span>
          <% end %>
        </p>
      </div>

      <div class="mb-4">
        <h2 class="text-xl font-semibold mb-2">Spectrum</h2>
        <p class="text-ink-2">
          <%= link_to @rating.spectrum.name, spectrum_path(@rating.spectrum), class: "text-accent-text hover:underline" %>
        </p>
        <p class="text-ink-3 text-sm mt-1"><%= @rating.spectrum.description %></p>
      </div>

      <div class="mb-4">
        <h2 class="text-xl font-semibold mb-2">Your Rating</h2>
        <div class="w-full bg-line rounded-full h-4 mb-2">
          <div class="<%= @rating.value >= 0 ? 'bg-green-600' : 'bg-red-600' %> h-4 rounded-full" style="width: <%= @rating.percentage_value %>%"></div>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-red-500"><%= @rating.spectrum.low_label %> (-10,000)</span>
          <span class="font-bold"><%= @rating.value %></span>
          <span class="text-green-500"><%= @rating.spectrum.high_label %> (+10,000)</span>
        </div>
      </div>

      <% if @rating.notes.present? %>
        <div class="mb-4">
          <h2 class="text-xl font-semibold mb-2">Notes</h2>
          <p class="text-ink-2"><%= @rating.notes %></p>
        </div>
      <% end %>

      <div class="mb-4">
        <h2 class="text-xl font-semibold mb-2">Rating Date</h2>
        <p class="text-ink-2"><%= @rating.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>

      <div class="flex space-x-2 mt-6">
        <%= link_to "Edit", edit_rating_path(@rating), class: "rounded-md px-3.5 py-2.5 bg-accent text-on-accent hover:opacity-90 inline-block font-medium" %>
        <%= button_to "Delete", @rating, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white inline-block font-medium", data: { turbo_confirm: "Are you sure?" } %>
        <%= link_to "Back to Ratings", ratings_path, class: "rounded-md px-3.5 py-2.5 bg-surface-2 hover:bg-line inline-block font-medium" %>
      </div>
    </div>
  </div>
</div>
