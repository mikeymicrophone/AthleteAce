<% content_for :title, "Campaigns" %>
<%= browse_header "Campaigns" %>
<div id="campaigns">
  <% @campaigns.each do |campaign| %>
    <%= index_record campaign do %>
      <%= link_to campaign.name, campaign, class: "identity-name" %>
      <%= entity_link campaign.team %>
      <%= entity_link campaign.season %>
      <%= entity_link campaign.league %>
    <% end %>
  <% end %>
</div>
<%= browse_empty @campaigns, "Campaigns" %>
