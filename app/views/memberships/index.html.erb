<% content_for :title, "Memberships" %>
<%= browse_header "Memberships" %>
<div id="memberships">
  <% @memberships.each do |membership| %>
    <%= index_record membership do %>
      <div>
        <span class="record-tag"><%= membership.active? ? "Active" : "Inactive" %></span>
        <%= link_to "View", membership, class: "tool-button" %>
      </div>
      <%= entity_link membership.team %>
      <%= entity_link membership.division %>
      <%= entity_link membership.conference %>
      <p class="text-sm text-ink-3"><%= membership.start_date&.strftime("%Y-%m-%d") || "Unknown start" %> to <%= membership.end_date&.strftime("%Y-%m-%d") || "Present" %></p>
    <% end %>
  <% end %>
</div>
<%= browse_empty @memberships, "Memberships" %>
