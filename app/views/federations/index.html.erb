<% content_for :title, "Federations" %>
<%= browse_header "Federations" %>
<div id="federations">
  <% @federations.each do |federation| %>
    <article class="catalog-record">
      <h2 class="profile-section-title"><%= link_to federation.name, federation %></h2>
      <p class="text-sm text-ink-3"><%= federation.abbreviation %></p>
      <p class="mt-3 text-ink-2"><%= federation.description %></p>
      <%= link_to "Show", federation, class: "tool-button mt-4" %>
    </article>
  <% end %>
</div>
<%= browse_empty @federations, "Federations" %>
