<ol class="moderation-list">
  <% decisions.each do |decision| %><li class="moderation-row"><div><p class="eyebrow"><%= decision.action.titleize %> · <%= decision.subject_type %> · revision <%= decision.revision %></p><p><%= decision.snapshot["name"] || "#{decision.subject_type} ##{decision.subject_id}" %></p><p><%= decision.reason %></p><p class="round-caption"><%= decision.actor ? ace_identity(decision.actor) : "System" %> · <%= l(decision.created_at, format: :long) %></p></div></li><% end %>
</ol>
