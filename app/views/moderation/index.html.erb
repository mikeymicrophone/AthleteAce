<% content_for :title, "Moderation queue" %>
<% content_for :side, "mod" %>
<div class="moderation-page">
  <header class="browse-header"><div><p class="eyebrow">Moderate</p><h1 class="page-title">Review queue</h1><p class="round-intro">Review submissions and record your decision.</p></div><%= link_to "Decision log", moderation_log_path, class: "tool-button" %></header>
  <nav class="moderation-tabs" aria-label="Submission status">
    <% %w[pending approved rejected hidden].each do |status| %>
      <%= link_to status.titleize, moderation_path(status: status), class: "tool-button", aria: { current: @status == status ? "page" : nil } %>
    <% end %>
  </nav>
  <p class="round-caption">Oldest first. Up to 100 submissions. Your own submissions are excluded.</p>
  <div class="moderation-list">
    <% @items.each do |item| %>
      <article class="moderation-row">
        <div><p class="eyebrow"><%= item.class.name %> · <%= item.moderation_status %></p><h2><%= link_to moderation_item_name(item), moderation_item_path(type: item.class.name, id: item.id) %></h2><p class="round-caption"><%= item.created_by&.email || "Catalog" %> · <%= time_ago_in_words(item.created_at) %> ago</p></div>
        <%= link_to "Review", moderation_item_path(type: item.class.name, id: item.id), class: "tool-button" %>
      </article>
    <% end %>
    <% if @items.empty? %><div class="round-panel"><h2>Nothing waiting here.</h2><p class="round-intro">Submissions with this status appear here when they need your attention.</p></div><% end %>
  </div>
</div>
