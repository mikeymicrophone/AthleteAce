<details class="moderation-shortcuts" data-moderation-target="shortcuts">
  <summary>Keyboard shortcuts <kbd>?</kbd></summary>
  <% if review %>
    <p><kbd>J</kbd> Next submission · <kbd>K</kbd> Previous submission · <kbd>A</kbd> Approve · <kbd>R</kbd> Focus the reason before rejecting</p>
  <% else %>
    <p><kbd>J</kbd> Next row · <kbd>K</kbd> Previous row · <kbd>Enter</kbd> Open review</p>
  <% end %>
  <p>Shortcuts pause while you type in a field.</p>
</details>
