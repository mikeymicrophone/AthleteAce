<% content_for :title, "Organizations" %>

<div class="w-full space-y-6">
  <%= browse_header "Organizations" do %>
    <span class="text-sm text-ink-3"><%= pluralize(@organizations.size, "organization") %></span>
  <% end %>
  <%= browse_empty @organizations, "Organizations" %>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <% @organizations.each do |organization| %>
      <%= link_to organization_path(organization), class: "rounded-card border border-line bg-surface p-6 transition hover:border-line-2" do %>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="profile-section-title"><%= organization.name %></h2>
            <% if organization.abbreviation.present? %>
              <p class="mt-1 text-sm font-semibold uppercase tracking-[0.14em] text-ink-3"><%= organization.abbreviation %></p>
            <% end %>
          </div>
          <div class="text-sm text-ink-3"><%= pluralize(organization.current_teams.size, "current team") %></div>
        </div>

        <% if organization.description.present? %>
          <p class="mt-4 text-sm leading-6 text-ink-2"><%= truncate(organization.description, length: 180) %></p>
        <% end %>

        <div class="mt-5 border-t border-line pt-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-ink-3">Current Teams</p>
          <% if organization.current_teams.any? %>
            <div class="flex flex-wrap gap-3">
              <% organization.current_teams.each do |team| %>
                <span class="inline-flex rounded-full bg-surface-2 px-3 py-1 text-sm font-medium text-ink">
                  <%= team.name %>
                </span>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-ink-3">No current teams linked.</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
