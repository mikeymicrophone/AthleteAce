<% content_for :title, @organization.name %>

<div class="w-full space-y-8">
  <%= browse_header @organization.name %>
  <section class="related-section">
    <% if @organization.abbreviation.present? %>
      <p class="mt-3 text-lg font-medium text-ink-2"><%= @organization.abbreviation %></p>
    <% end %>
    <% if @organization.description.present? %>
      <p class="mt-4 max-w-3xl text-base leading-7 text-ink-2"><%= @organization.description %></p>
    <% end %>
    <% if @organization.url.present? %>
      <div class="mt-4">
        <%= external_link_to @organization.url, class: "text-sm font-semibold text-accent-text hover:underline" %>
      </div>
    <% end %>
  </section>

  <%= render "staff_tenures/list", staff_tenures: @staff_tenures %>

  <div class="grid grid-cols-1 gap-8 xl:grid-cols-2">
    <section class="rounded-card border border-line bg-surface p-6">
      <div class="mb-5 flex items-end justify-between gap-4 border-b border-line pb-4">
        <h2 class="profile-section-title">Current Teams</h2>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3"><%= pluralize(@organization.current_teams.size, "team") %></p>
      </div>

      <% if @organization.current_teams.any? %>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <% @organization.current_teams.each do |team| %>
            <%= link_to team_path(team), class: "rounded-card border border-line bg-surface-2 px-4 py-4 transition hover:border-line-2 hover:bg-surface" do %>
              <%= display_name_with_lazy_logo(team, link: false) %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-ink-3">No current teams linked to this organization.</p>
      <% end %>
    </section>

    <section class="rounded-card border border-line bg-surface p-6">
      <div class="mb-5 flex items-end justify-between gap-4 border-b border-line pb-4">
        <h2 class="profile-section-title">Affiliation History</h2>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3"><%= pluralize(@organization.organization_affiliations.size, "affiliation") %></p>
      </div>

      <% if @organization.organization_affiliations.any? %>
        <div class="space-y-3">
          <% @organization.organization_affiliations.chronological.each do |affiliation| %>
            <%= link_to organization_affiliation_path(affiliation), class: "block rounded-card border border-line bg-surface-2 px-4 py-4 transition hover:border-line-2 hover:bg-surface" do %>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-base font-semibold text-ink"><%= affiliation.team.name %></p>
                  <p class="mt-1 text-sm text-ink-3"><%= affiliation.team.league.name %></p>
                </div>
                <div class="text-right text-sm text-ink-2">
                  <p><%= affiliation.start_date&.strftime("%Y-%m-%d") || "Unknown start" %></p>
                  <p><%= affiliation.end_date&.strftime("%Y-%m-%d") || "Present" %></p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-ink-3">No affiliations recorded for this organization.</p>
      <% end %>
    </section>
  </div>
</div>
