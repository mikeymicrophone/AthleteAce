<% content_for :title, @country.name %>
<%= browse_header @country.name %>
<%= render_collection @country.states.order(:name), parent: @country, link_to_collection: true, logo_attribute: :flag_url %>
<%= render_collection @country.cities.order(cities: { name: :asc }), parent: @country, link_to_collection: true, limit: 12 %>
<%= render_collection @country.stadiums.order(stadiums: { name: :asc }), parent: @country, link_to_collection: true, limit: 12 %>
<%= render_collection @country.leagues, parent: @country, link_to_collection: true %>
