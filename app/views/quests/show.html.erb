<% content_for :title, @quest.name %>
<% goal = quest_goal(@quest) %>
<% highlights = @quest.highlights.ordered.includes(achievement: :target).to_a %>
<div class="quest-detail" id="<%= dom_id @quest %>">
  <%= link_to "← All quests", quests_path, class: "tool-link" %>
  <% if @random_mode %>
    <section id="quest_discovery" class="play-panel play-section-heading"><div><h2>Quest Discovery</h2><p>Explore this quest or find another one.</p></div><%= link_to "Next Quest", random_quests_path, class: "tool-button" %></section>
  <% end %>
  <header class="browse-header">
    <div><p class="eyebrow">Quest · <%= pluralize(highlights.size, "achievement") %></p><h1 class="page-title"><%= @quest.name %></h1><p class="round-intro"><%= @quest.description %></p></div>
    <div class="quest-card-meta"><%= quest_participants_badge @quest %><p><%= pluralize(highlights.count(&:required?), "achievement") %> required</p></div>
  </header>
  <section class="quest-goal-panel" aria-labelledby="quest-goal-title">
    <div><p class="eyebrow">Your goal</p><h2 id="quest-goal-title"><%= goal ? "Keep your eyes on the roster." : "Make this your next quest." %></h2><p><%= goal ? "Adopted #{l(goal.created_at.to_date, format: :long)}" : "Choose this quest and keep your progress close." %></p></div>
    <% if goal %><%= render "quests/progress", goal: goal %><% end %>
    <div class="page-actions">
      <% if ace_signed_in? %><%= begin_quest_button @quest %><% else %><%= link_to "Sign in to begin", new_ace_session_path, class: "game-button" %><% end %>
    </div>
  </section>
  <div class="play-section-heading"><h2>Achievements in this Quest</h2><%= link_to "Add Achievement", new_quest_highlight_path(@quest), class: "tool-button" if ace_signed_in? %></div>
  <% if highlights.empty? %>
    <div class="play-panel play-empty"><h3>No achievements added yet.</h3><p>This quest is waiting for its first challenge.</p></div>
  <% end %>
  <% [[true, "Required Achievements"], [false, "Optional Achievements"]].each do |required, heading| %>
    <% entries = highlights.select { |highlight| highlight.required? == required } %>
    <% if entries.any? %>
      <section class="quest-achievements"><h3 class="eyebrow"><%= heading %></h3><ol>
        <% entries.each_with_index do |highlight, index| %>
          <% achievement = highlight.achievement %>
          <li class="quest-achievement"><span class="quest-achievement-number"><%= format("%02d", index + 1) %></span><div class="quest-achievement-copy"><h4><%= link_to achievement.name, achievement_path(achievement) %></h4><p><%= achievement.description %></p><span class="entity-chip"><%= icon_for_resource achievement.target_type.underscore, size: 16 %><%= achievement.target ? link_to_name(achievement.target) : "Target unavailable" %></span></div>
            <div class="page-actions"><% if (practice_path = quest_practice_path(achievement)) %><%= link_to "Practice", practice_path, class: "tool-button", aria: { label: "Practice #{achievement.name}" } %><% end %>
              <% if admin_signed_in? %><%= link_to "Edit", edit_quest_highlight_path(@quest, highlight), class: "tool-link" %><%= button_to "Remove", quest_highlight_path(@quest, highlight), method: :delete, class: "tool-link", data: { turbo_confirm: "Remove this achievement from the quest?" } %><% end %>
            </div>
          </li>
        <% end %>
      </ol></section>
    <% end %>
  <% end %>
</div>
