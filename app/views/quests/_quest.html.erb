<article id="<%= dom_id quest %>" class="quest-card">
  <div class="quest-card-top"><%= icon "script", size: 28 %><span class="eyebrow"><%= pluralize(quest.highlights.count(&:required?), 'required achievement') %></span></div>
  <h2><%= link_to quest.name, quest_path(quest) %></h2>
  <p class="quest-card-description"><%= quest.description %></p>
  <div class="quest-card-meta"><%= quest_participants_badge(quest) %></div>
  <% if (goal = quest_goal(quest)) %><%= render "quests/progress", goal: goal %><% end %>
  <div class="page-actions"><%= link_to "View quest", quest_path(quest), class: "tool-button" %><%= begin_quest_button quest %><%= link_to "Edit", edit_quest_path(quest), class: "tool-link" if admin_signed_in? %></div>
</article>
