<% content_for :title, "Quests" %>
<div class="quest-browser">
  <header class="browse-header">
    <div><p class="eyebrow">Give your practice a purpose</p><h1 class="page-title">Quests</h1><p class="round-intro">Find a roster, a rivalry, or a whole league to get to know.</p></div>
    <div class="page-actions"><%= link_to "Back to Play", strength_path, class: "tool-button" %><%= link_to "New quest", new_quest_path, class: "game-button" if ace_signed_in? %></div>
  </header>
  <div id="quests" class="quest-grid">
    <% if @quests.any? %>
      <%= render @quests %>
    <% else %>
      <section class="play-panel play-empty quest-empty"><%= icon "script", size: 40 %><h2>No quests yet</h2><p>There is still plenty to practice. Pick a game and start a round.</p><%= link_to "Pick a round", new_game_round_path, class: "game-button" %></section>
    <% end %>
  </div>
</div>
