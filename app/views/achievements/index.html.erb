<% content_for :title, "Achievements" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= browse_header "Achievements" do %>
    <%= link_to "New achievement", new_achievement_path, class: "tool-button" %>
  <% end %>

  <div id="achievements" class="min-w-full divide-y divide-line space-y-5">
    <% if @achievements.any? %>
      <% @achievements.each do |achievement| %>
        <div class="catalog-record">
          <%= render achievement %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", achievement, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-surface-2 hover:bg-surface-2 inline-block font-medium" %>
            <%= link_to "Add to Quest", new_highlight_path(achievement_id: achievement.id), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-accent text-on-accent hover:opacity-90 inline-block font-medium" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= browse_empty @achievements, "Achievements" %>
    <% end %>
  </div>
</div>
