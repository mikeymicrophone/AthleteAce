<% content_for :title, "Athlete Name Training" %>

<%= tag.header class: "training-header" do %>
  <%= tag.p "Play", class: "eyebrow" %>
  <%= tag.h1 "Strength Training", class: "page-title" %>
  <%= tag.p "Choose a training method below to improve your ability to recognize and recall athlete names.", class: "training-intro" %>
<% end %>

<%= tag.div class: "training-grid" do %>
  <% [
    ["Multiple Choice", "Test your knowledge with multiple choice questions about athletes.", "target", strength_multiple_choice_path],
    ["Phased Repetition", "Learn names through spaced repetition for better long-term retention.", "repeat", strength_phased_repetition_path(team_id: @team_id, sport_id: @sport_id, league_id: @league_id, include_inactive: @include_inactive)],
    ["Image Recognition", "Match athlete faces with their names to build visual recognition.", "photo", strength_images_path],
    ["Name Ciphers", "Decode scrambled athlete names to strengthen your recall.", "search", strength_ciphers_path],
    ["Team Match", "Match players to their correct teams to build your team knowledge.", "shield", strength_team_match_path(team_id: @team_id, sport_id: @sport_id, league_id: @league_id, include_inactive: @include_inactive)]
  ].each do |title, description, glyph, path| %>
    <%= link_to path, class: "training-card #{title == 'Team Match' ? 'training-card-featured' : ''}" do %>
      <%= tag.div class: "training-card-icon" do %>
        <%= icon glyph, size: 32 %>
        <%= icon "arrow-up-right", size: 24 %>
      <% end %>
      <%= tag.h2 title, class: "training-card-title" %>
      <%= tag.p description, class: "training-card-description" %>
    <% end %>
  <% end %>
<% end %>

  <div class="training-filters">
    <h2 class="">Filter Your Training</h2>
    <%= form_with url: strength_path, method: :get, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :sport_id, "Sport", class: "block text-sm font-medium text-ink-2 mb-1" %>
          <%= f.collection_select :sport_id, @sports, :id, :name,
              { include_blank: "All Sports", selected: @sport_id },
              class: "training-select",
              onchange: "this.form.submit();" %>
        </div>

        <div>
          <%= f.label :league_id, "League", class: "block text-sm font-medium text-ink-2 mb-1" %>
          <%= f.collection_select :league_id, @leagues, :id, :name,
              { include_blank: "All Leagues", selected: @league_id },
              class: "training-select",
              onchange: "this.form.submit();" %>
        </div>

        <div>
          <%= f.label :team_id, "Team", class: "block text-sm font-medium text-ink-2 mb-1" %>
          <%= f.collection_select :team_id, @teams, :id, :name,
              { include_blank: "All Teams", selected: @team_id },
              class: "training-select",
              onchange: "this.form.submit();" %>
        </div>
      </div>

      <div class="flex items-center">
        <%= f.check_box :include_inactive,
            {
              class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500",
              checked: @include_inactive == "true",
              onchange: "this.form.submit();"
            },
            "true", "false" %>
        <%= f.label :include_inactive, "Include inactive players", class: "ml-2 block text-sm text-ink-2" %>
      </div>

      <!-- Apply Filters button removed as filters now apply automatically when changed -->
    <% end %>
  </div>

  <div class="training-explainer">
    <h2 class="text-2xl font-bold text-ink mb-2">Why Train Your Name Recognition?</h2>
    <p class="text-ink-2 mb-4">Recognizing athletes by name enhances your enjoyment of sports and deepens your connection to the games you love. Regular practice helps you:</p>
    <ul class="list-disc pl-5 text-ink-2 space-y-2">
      <li>Follow games more easily when commentators mention players</li>
      <li>Engage in more meaningful conversations with other fans</li>
      <li>Appreciate player achievements and career trajectories</li>
      <li>Build a stronger connection to your favorite teams</li>
    </ul>
  </div>
