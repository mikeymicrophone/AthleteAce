<% content_for :title, "Teams" %>

<%= browse_header "Teams" do %>
  <%= link_to new_game_round_path, class: "game-button" do %>
    <%= icon "player-play", size: 20 %>
    <%= tag.span "Team Match" %>
  <% end %>
<% end %>

<%= team_search_form(@q) %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4">
  <div class="mb-4 sm:mb-0">
    <div class="text-sm text-gray-600 mb-1">Sort by:</div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Mascot", teams_path(sort: "mascot"), class: "tool-link #{params[:sort] == 'mascot' ? 'font-bold' : ''}" %>
      <%= link_to "Territory", teams_path(sort: "territory"), class: "tool-link #{params[:sort] == 'territory' ? 'font-bold' : ''}" %>
      <%= link_to "Sport", teams_path(sort: "sport"), class: "tool-link #{params[:sort] == 'sport' ? 'font-bold' : ''}" %>
      <%= link_to "City", teams_path(sort: "city"), class: "tool-link #{params[:sort] == 'city' ? 'font-bold' : ''}" %>
    </div>
  </div>
</div>

<%# Page-level Spectrum Picker %>
<%= render_floating_spectrum_picker %>

<div id="teams" class="space-y-4">
  <% @teams.each do |team| %>
    <%= tag.div(id: dom_id(team), class: "index-record team-record") do %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
        <%= tag.div class: "team-info" do %>
          <%= record_identity team %>
          <%= tag.div class: "record-metadata" do %>
            <%= entity_link team.stadium %>
            <%= entity_link team.league %>
          <% end %>
        <% end %>

        <%= rating_slider_container(team, selected_spectrums) %>

        <div class="team-links md:col-span-1 text-right flex flex-wrap items-center justify-end gap-3">
          <%= link_to pluralize(team.players.count, "player"), [team, :players], class: "tool-link" %>
          <%= quiz_link(team, title: "Test your knowledge about #{team.name}") %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<%# Standard Pagy pagination navigation %>
<% if @pagy.pages > 1 %>
  <div class="my-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>

  <%# Simple per-page selector %>
  <div class="flex justify-center mt-2 mb-8">
    <div class="text-sm text-gray-600">
      Items per page:
      <% [5, 10, 20, 50].each do |per_page| %>
        <% if params[:per_page].to_i == per_page || (params[:per_page].blank? && per_page == Pagy::OPTIONS[:limit]) %>
          <span class="font-bold px-2"><%= per_page %></span>
        <% else %>
          <%= link_to per_page, teams_path(per_page: per_page), class: "text-blue-600 hover:underline px-2" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
