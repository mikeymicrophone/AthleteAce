<% content_for :title, @team.name %>
<%= render 'filtered_show' if @filtered_breadcrumb.present? %>
<%= browse_header @team.name do %>
  <%= render "follows/button", record: @team %>
  <%= link_to "Write a shout-out draft", new_shout_out_draft_path(target_type: "Team", target_id: @team.id), class: "tool-button" %>
  <%= link_to "Practice this team", new_game_round_path(team_id: @team.id), class: "game-button" %>
<% end %>
<section class="round-panel">
  <div class="profile-chips"><%= entity_link @team.league %><%= entity_link @team.division %><%= entity_link @team.stadium %><%= entity_link @team.current_organization %></div>
  <%= link_to "Explore roster seasons", new_game_round_path(team_id: @team.id), class: "tool-link" %>
</section>
<section id="<%= dom_id(@team, :players_on) %>" class="round-panel">
  <h2 class="profile-section-title">Players</h2>
  <% if @team.players.any? %>
    <ul class="play-game-grid">
      <% @team.players.order(:last_name, :first_name).each do |player| %>
        <li class="index-record"><%= record_identity player %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="round-caption">No current-team player assignments recorded. Choose a roster season in round setup to use historical player lists.</p>
  <% end %>
</section>
<section class="round-panel">
  <h2 class="profile-section-title">How aces rate <%= @team.name %></h2>
  <%= rating_slider_container @team, Spectrum.visible_to(current_ace).order(:name) %>
</section>
