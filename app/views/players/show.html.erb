<% content_for :title, @player.name %>

<%= tag.div class: "player-profile" do %>
  <%= render "filtered_show" %>
  <%= tag.header class: "player-hero" do %>
    <%= player_hero_portrait @player %>
    <%= tag.div class: "player-hero-details" do %>
      <%= tag.p "Player", class: "eyebrow entity-kind", data: { entity: "player" } %>
      <%= tag.h1 @player.name, class: "page-title" %>
      <%= tag.p player_status_line(@player), class: "player-status-line" %>
      <%= tag.div class: "profile-chips" do %>
        <%= entity_link @player.team %>
        <%= entity_link @player.team&.division %>
        <%= entity_link @player.league %>
      <% end %>
      <% if @player.team %>
        <%= tag.div class: "page-actions" do %>
          <%= link_to new_game_round_path(team_id: @player.team_id), class: "game-button" do %>
            <%= icon "player-play", size: 20 %>
            <%= tag.span "Quiz: #{@player.team.name}" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.section class: "profile-section", aria: { labelledby: "player-memory-title" } do %>
    <%= tag.h2 "Your memory", id: "player-memory-title", class: "profile-section-title" %>
    <% if @memory_stats %>
      <%= tag.dl class: "memory-stats" do %>
        <% { "Seen" => @memory_stats[:seen], "Right" => @memory_stats[:accuracy], "Last miss" => @memory_stats[:last_miss] }.each do |label, value| %>
          <%= tag.div class: "memory-stat" do %>
            <%= tag.dt label, class: "eyebrow" %>
            <%= tag.dd value, class: "memory-value" %>
          <% end %>
        <% end %>
      <% end %>
      <% if @memory_stats[:seen].zero? %>
        <%= tag.p "You haven’t answered a question about #{@player.name} yet.", class: "profile-empty" %>
      <% end %>
    <% else %>
      <%= tag.p class: "profile-empty" do %>
        <%= link_to "Sign in", new_ace_session_path, class: "tool-link" %>
        <%= " to track your practice with #{@player.name}." %>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.section class: "profile-section profile-ratings", aria: { labelledby: "player-ratings-title" } do %>
    <%= tag.h2 "Player Ratings", id: "player-ratings-title", class: "profile-section-title" %>
    <% if @spectrums.any? %>
      <%= rating_slider_container @player, @spectrums %>
    <% else %>
      <%= tag.p "No rating spectrums have been created yet.", class: "profile-empty" %>
    <% end %>
  <% end %>

  <%= tag.section class: "profile-section", aria: { labelledby: "player-related-title" } do %>
    <%= tag.h2 "Related", id: "player-related-title", class: "profile-section-title" %>
    <%= tag.dl class: "profile-related" do %>
      <% {
        "Plays for" => [@player.team], "Organization" => [@player.current_organization],
        "Sport" => [@player.sport], "Stadium" => [@player.team&.stadium],
        "Location" => [@player.team&.city, @player.team&.state], "Positions" => @player.positions
      }.each do |label, records| %>
        <% if records.compact.any? %>
          <%= tag.div do %>
            <%= tag.dt label, class: "eyebrow" %>
            <%= tag.dd safe_join(records.compact.map { |record| entity_link record }), class: "profile-chips" %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @seasons.any? %>
    <%= tag.section class: "profile-section", aria: { labelledby: "player-seasons-title" } do %>
      <%= tag.h2 "Seasons", id: "player-seasons-title", class: "profile-section-title" %>
      <%= tag.div safe_join(@seasons.map { |season| entity_link season }), class: "profile-chips" %>
    <% end %>
  <% end %>
<% end %>
