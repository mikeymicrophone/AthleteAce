<%= account_card "Reset password", "Enter your email and we’ll send you a link to choose a new password." do %>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "account-form" } do |form| %>
    <%= render "aces/shared/error_messages", resource: resource %>
    <%= account_field form, :email, type: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= form.submit "Send reset instructions", class: "game-button" %>
  <% end %>
  <%= render "aces/shared/links" %>
<% end %>
