<%= account_card "New password", "Choose a new password for your Athlete Ace account." do %>
  <%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "account-form" } do |form| %>
    <%= render "aces/shared/error_messages", resource: resource %>
    <%= form.hidden_field :reset_password_token %>
    <%= account_field form, :password, type: :password, label: "New password", autofocus: true, autocomplete: "new-password", required: true, hint: account_password_hint %>
    <%= account_field form, :password_confirmation, type: :password, label: "Confirm new password", autocomplete: "new-password", required: true %>
    <%= form.submit "Change my password", class: "game-button" %>
  <% end %>
  <%= render "aces/shared/links" %>
<% end %>
