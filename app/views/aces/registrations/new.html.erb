<%= account_card "Join the Aces", "Create your account to rate players and track your practice." do %>
  <%= form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: "account-form" } do |form| %>
    <%= render "aces/shared/error_messages", resource: resource %>
    <%= account_field form, :email, type: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= account_field form, :password, type: :password, autocomplete: "new-password", required: true, hint: account_password_hint %>
    <%= account_field form, :password_confirmation, type: :password, label: "Confirm password", autocomplete: "new-password", required: true %>
    <%= form.submit "Sign up", class: "game-button" %>
  <% end %>
  <%= render "aces/shared/links" %>
<% end %>
