<% if resource.errors.any? %>
  <%= tag.div id: "error_explanation", class: "account-errors", role: "alert", data: { turbo_cache: false } do %>
    <%= tag.h2 I18n.t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase) %>
    <%= tag.ul do %>
      <% resource.errors.full_messages.each do |message| %>
        <%= tag.li message %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
