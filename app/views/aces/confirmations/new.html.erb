<%= account_card "Confirm your email", "We’ll send you a fresh link to confirm your Athlete Ace account." do %>
  <%= form_for resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "account-form" } do |form| %>
    <%= render "aces/shared/error_messages", resource: resource %>
    <%= account_field form, :email, type: :email, autofocus: true, autocomplete: "email", required: true,
      value: resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email %>
    <%= form.submit "Resend confirmation", class: "game-button" %>
  <% end %>
  <%= render "aces/shared/links" %>
<% end %>
