<%= account_card "Sign in", "Save your ratings and pick up where you left off." do %>
  <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "account-form" } do |form| %>
    <%= account_field form, :email, type: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= account_field form, :password, type: :password, autocomplete: "current-password", required: true %>
    <%= tag.div class: "account-options" do %>
      <% if devise_mapping.rememberable? %>
        <%= tag.label class: "account-remember" do %>
          <%= form.check_box :remember_me %>
          <%= tag.span "Remember me" %>
        <% end %>
      <% end %>
      <%= link_to "Forgot your password?", new_password_path(resource_name) if devise_mapping.recoverable? %>
    <% end %>
    <%= form.submit "Sign in", class: "game-button" %>
  <% end %>
  <%= render "aces/shared/links" %>
<% end %>
