<% content_for :title, "Sports data · Games" %>
<div class="moderation-page people-page">
  <%= link_to "Back to sports data", admin_catalog_records_path, class: "tool-link" %>
  <header class="browse-header"><div><p class="eyebrow">Admin · Sports data</p><h1 class="page-title">Games</h1><p>Inspect schedules and recorded participation.</p></div></header>
  <%= form_with url: admin_games_path, method: :get, class: "people-filters" do |form| %>
    <div><%= form.label :q, "Search games" %><%= form.search_field :q, value: @directory.query, maxlength: 80, placeholder: "Name or entity code", class: "account-input" %></div>
    <div><%= form.label :competition_id, "Competition" %><%= form.select :competition_id, options_from_collection_for_select(@competitions, :id, :name, @directory.competition_id), { include_blank: "All competitions" }, class: "account-input" %></div>
    <div><%= form.label :season_id, "Participating season" %><%= form.select :season_id, options_from_collection_for_select(@seasons, :id, :name, @directory.season_id), { include_blank: "All seasons" }, class: "account-input" %></div>
    <div><%= form.label :team_id, "Participating team" %><%= form.select :team_id, options_from_collection_for_select(@teams, :id, :name, @directory.team_id), { include_blank: "All teams" }, class: "account-input" %></div>
    <div><%= form.label :from, "From date" %><%= form.date_field :from, value: @directory.from, class: "account-input" %></div>
    <div><%= form.label :to, "Through date" %><%= form.date_field :to, value: @directory.to, class: "account-input" %></div>
    <div><%= form.label :participation, "Appearances" %><%= form.select :participation, options_for_select([["All games", ""], ["Recorded appearances", "recorded"], ["No recorded appearances", "missing"]], @directory.participation), {}, class: "account-input" %></div>
    <div class="page-actions"><%= form.submit "Filter games", class: "tool-button" %><%= link_to "Clear", admin_games_path, class: "tool-link" %></div>
  <% end %>
  <p class="round-caption"><%= pluralize @pagy.count, "matching game" %> · Newest dated games first. No recorded appearances does not establish that nobody played.</p>
  <div class="people-table"><table><thead><tr><th>Game</th><th>Date</th><th>Teams and seasons</th><th>Competitions</th><th>Recorded appearances</th></tr></thead><tbody>
    <% @games.each do |game| %>
      <tr><td><%= link_to contest_display_name(game), admin_game_path(game) %><p class="round-caption"><%= game.entity_code.presence || "No entity code" %></p></td><td><%= game.begin_date&.iso8601 || "Unknown" %></td>
        <td><% game.contestants.sort_by(&:id).each do |entry| %><p><%= entry.campaign.name %> · <%= entry.campaign.season.name %></p><% end %><% if game.contestants.empty? %>No recorded participants<% end %></td>
        <td><% game.competition_memberships.sort_by(&:id).each do |membership| %><p><%= contest_display_name(membership.contest) %> · <%= competition_game_summary(membership) %></p><% end %><% if game.competition_memberships.empty? %>Unlinked<% end %></td>
        <td><%= @appearance_counts.fetch(game.id, 0) %></td></tr>
    <% end %>
  </tbody></table></div>
  <% if @games.empty? %><section class="round-panel"><h2>No matching games.</h2><p>Try another name or change the filters.</p></section><% end %>
  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
