<p class="round-caption">Effective dates have day resolution. These records do not supply an exact event time or automatically change contracts and stints.</p>
<div class="people-table"><table><thead><tr><th>Event</th><th>Effective date</th><th>From organization</th><th>To organization</th><th>From team</th><th>To team</th><th>Recorded metadata</th></tr></thead><tbody>
  <% @records.each do |entry| %><% event = entry.event %><tr><td><%= event.kind %><p class="round-caption"><%= event.entity_code.presence || "No event code" %> · <%= entry.entity_code.presence || "No entry code" %></p></td><td><%= event.effective_on&.iso8601 || "Unknown" %></td><td><%= entry.from_organization&.name || "Not set" %></td><td><%= entry.to_organization&.name || "Not set" %></td><td><%= entry.from_team&.name || "Not set" %></td><td><%= entry.to_team&.name || "Not set" %></td><td><%= render "metadata", source: event.source, details: event.details %><details><summary>Player entry details</summary><p><%= entry.details.to_json %></p></details></td></tr><% end %>
</tbody></table></div>
