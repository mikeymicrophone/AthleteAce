<p class="round-caption">Roster observations are not actual appearances. Coverage describes the observation, and an effective date can differ from the observation time.</p>
<div class="people-table"><table><thead><tr><th>Campaign</th><th>Effective date</th><th>Observed at</th><th>Roster</th><th>Status</th><th>Jersey</th><th>Recorded metadata</th></tr></thead><tbody>
  <% @records.each do |entry| %><% roster = entry.roster %><tr><td><%= roster.campaign.name %><p class="round-caption"><%= roster.campaign.season.name %></p></td><td><%= roster.effective_on&.iso8601 || "Unknown" %></td><td><%= roster.observed_at&.utc&.iso8601 || "Unknown" %></td><td><%= roster.kind %> · <%= roster.coverage %><p class="round-caption"><%= roster.entity_code.presence || "No roster code" %> · <%= entry.entity_code.presence || "No entry code" %></p></td><td><%= entry.status.presence || "Unknown" %></td><td><%= entry.jersey_number.presence || "Unknown" %></td><td><%= render "metadata", source: roster.source, details: roster.details %><details><summary>Player entry metadata</summary><p>Source: <%= entry.source.to_json %></p><p>Details: <%= entry.details.to_json %></p></details></td></tr><% end %>
</tbody></table></div>
