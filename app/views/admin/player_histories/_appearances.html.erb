<div class="people-table"><table><thead><tr><th>Game</th><th>Date</th><th>Campaign</th><th>Jersey</th><th>Starter</th><th>Statistics</th><th>Recorded metadata</th></tr></thead><tbody>
  <% @records.each do |appearance| %><% game = appearance.contestant.contest %><tr><td><%= link_to contest_display_name(game), admin_game_path(game) %><p class="round-caption"><%= appearance.entity_code.presence || "No entity code" %></p></td><td><%= game.begin_date&.iso8601 || "Unknown" %></td><td><%= appearance.contestant.campaign.name %><p class="round-caption"><%= appearance.contestant.campaign.season.name %></p></td><td><%= appearance.jersey_number.presence || "Unknown" %></td><td><%= appearance.starter.nil? ? "Unknown" : appearance.starter ? "Yes" : "No" %></td><td><%= appearance.statistics.to_json %></td><td><%= render "metadata", source: appearance.source, details: appearance.details %></td></tr><% end %>
</tbody></table></div>
