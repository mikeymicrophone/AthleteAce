<% content_for :title, "#{@organization_affiliation.team.name} Organization Affiliation" %>

<div class="w-full space-y-8">
  <%= browse_header "#{@organization_affiliation.team.name} Organization Affiliation" %>
  <section class="related-section">
    <p class="mt-3 text-lg text-ink-2">
      Part of
      <%= link_to @organization_affiliation.organization.name, organization_path(@organization_affiliation.organization), class: "font-semibold text-accent-text hover:underline" %>
    </p>
  </section>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="rounded-card border border-line bg-surface p-6">
      <h2 class="profile-section-title">Affiliation Details</h2>
      <dl class="mt-5 space-y-4">
        <div class="rounded-card bg-surface-2 p-4">
          <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">Organization</dt>
          <dd class="mt-2 text-lg font-semibold text-ink"><%= link_to @organization_affiliation.organization.name, @organization_affiliation.organization %></dd>
        </div>
        <div class="rounded-card bg-surface-2 p-4">
          <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">Team</dt>
          <dd class="mt-2 text-lg font-semibold text-ink"><%= link_to @organization_affiliation.team.name, @organization_affiliation.team %></dd>
        </div>
        <div class="rounded-card bg-surface-2 p-4">
          <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">Start Date</dt>
          <dd class="mt-2 text-lg font-semibold text-ink"><%= @organization_affiliation.start_date&.strftime("%B %d, %Y") || "Unknown" %></dd>
        </div>
        <div class="rounded-card bg-surface-2 p-4">
          <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">End Date</dt>
          <dd class="mt-2 text-lg font-semibold text-ink"><%= @organization_affiliation.end_date&.strftime("%B %d, %Y") || "Present" %></dd>
        </div>
      </dl>
    </section>

    <section class="rounded-card border border-line bg-surface p-6">
      <h2 class="profile-section-title">Context</h2>
      <dl class="mt-5 space-y-4">
        <% if @organization_affiliation.team.league.present? %>
          <div class="rounded-card bg-surface-2 p-4">
            <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">League</dt>
            <dd class="mt-2 text-lg font-semibold text-ink"><%= link_to @organization_affiliation.team.league.name, @organization_affiliation.team.league %></dd>
          </div>
        <% end %>
        <% if @organization_affiliation.sport.present? %>
          <div class="rounded-card bg-surface-2 p-4">
            <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">Sport</dt>
            <dd class="mt-2 text-lg font-semibold text-ink"><%= link_to @organization_affiliation.sport.name, @organization_affiliation.sport %></dd>
          </div>
        <% end %>
        <% if @organization_affiliation.details.present? %>
          <div class="rounded-card bg-surface-2 p-4">
            <dt class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-3">Details</dt>
            <dd class="mt-2 text-sm text-ink-2"><pre class="browse-json"><%= JSON.pretty_generate(@organization_affiliation.details) %></pre></dd>
          </div>
        <% end %>
      </dl>
    </section>
  </div>
</div>
