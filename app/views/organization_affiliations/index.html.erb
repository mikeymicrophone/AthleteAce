<% content_for :title, "Organization Affiliations" %>

<div class="w-full space-y-6">
  <%= browse_header "Organization Affiliations" do %>
    <span class="text-sm text-ink-3"><%= pluralize(@organization_affiliations.size, "affiliation") %></span>
  <% end %>
  <%= browse_empty @organization_affiliations, "Organization Affiliations" %>

  <div class="space-y-3">
    <% @organization_affiliations.each do |affiliation| %>
      <%= link_to organization_affiliation_path(affiliation), class: "block rounded-card border border-line bg-surface px-5 py-4  transition  hover:border-line-2" do %>
        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-lg font-semibold text-ink"><%= affiliation.team.name %></p>
            <p class="text-sm text-ink-2">
              <%= affiliation.organization.name %>
              <% if affiliation.team.league.present? %>
                • <%= affiliation.team.league.name %>
              <% end %>
            </p>
          </div>
          <div class="text-sm text-ink-3 md:text-right">
            <div><%= affiliation.start_date&.strftime("%Y-%m-%d") || "Unknown start" %></div>
            <div><%= affiliation.end_date&.strftime("%Y-%m-%d") || "Present" %></div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
