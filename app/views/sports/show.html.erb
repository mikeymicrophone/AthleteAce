<% content_for :title, @sport.name %>
<%= browse_header @sport.name do %>
  <%= link_to "Teams", [@sport, :teams], class: "tool-button" %>
  <%= link_to "Players", [@sport, :players], class: "tool-button" %>
<% end %>
<%= render_collection @sport.leagues.order(:name), parent: @sport, link_to_collection: true %>
<%= render_collection @sport.conferences, parent: @sport, link_to_collection: true %>
<%= render_collection @sport.divisions, parent: @sport, link_to_collection: true %>
<%= render_collection @sport.teams.order(:territory, :mascot), parent: @sport, link_to_collection: true, limit: 12 %>
<%= render_collection @sport.players.order(:last_name, :first_name), parent: @sport, link_to_collection: true, limit: 12, logo_attribute: :photo_url %>
