<% content_for :title, "Year #{@year.number}" %>
<%= browse_header "Year #{@year.number}" do %>
  <%= link_to "Back to Years", years_path, class: "tool-button" %>
<% end %>
<%= browse_metadata "Year Number" => @year.number, "Created" => "#{time_ago_in_words(@year.created_at)} ago", "Seed Version" => @year.seed_version, "Last Seeded" => (@year.last_seeded_at && "#{time_ago_in_words(@year.last_seeded_at)} ago") %>
<%= render_collection @year.seasons.includes(:league) %>
