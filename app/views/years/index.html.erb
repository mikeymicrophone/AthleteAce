<% content_for :title, "Years" %>
<%= browse_header "Years" %>
<%= index_collection "years" do %>
  <% @years.each do |year| %>
    <%= index_record year do %>
      <%= link_to year.name, year, class: "identity-name" %>
      <span class="record-metadata"><%= pluralize(year.seasons.count, "season") %></span>
    <% end %>
  <% end %>
<% end %>
<%= browse_empty @years, "Years" %>
<%== @pagy.series_nav if @pagy.pages > 1 %>
