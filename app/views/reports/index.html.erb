<% content_for :title, "Reports inbox" %>
<%= browse_header "Reports inbox", eyebrow: "Moderate" do %><%= link_to "Review queue", moderation_path, class: "tool-button" %><% end %>
<p class="round-intro">Live content aces flagged · most-reported first. Your own posts are excluded.</p>
<nav class="history-tabs" aria-label="Report status">
  <%= link_to "Open #{@open_count}", reports_path, aria: { current: @status == "open" ? "page" : nil } %>
  <%= link_to "Resolved · #{@resolved_count} this week", reports_path(status: "resolved"), aria: { current: @status == "resolved" ? "page" : nil } %>
</nav>
<div class="moderation-list">
  <% @posts.each do |post| %>
    <article class="moderation-row">
      <div><h2><%= link_to post.target_name, report_path(post) %></h2><%= render "aces/attribution", ace: post.created_by %><p class="draft-message"><%= post.message %></p><p><%= pluralize post.report_count, "report" %> · first reported <%= time_ago_in_words(post.first_reported_at) %> ago</p></div>
      <%= link_to "Review reports", report_path(post), class: "tool-button" %>
    </article>
  <% end %>
  <% if @posts.empty? %><section class="round-panel"><h2>No <%= @status %> reports.</h2><p>Reports from signed-in aces appear here.</p></section><% end %>
</div>
<%== @pagy.series_nav if @pagy.pages > 1 %>
